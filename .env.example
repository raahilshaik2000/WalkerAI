# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe (publishable key only — secret key stays in Supabase Edge Function secrets)
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Claude API (use in Edge Functions only — do NOT expose client-side)
ANTHROPIC_API_KEY=sk-ant-...

# REimagineHome (Edge Functions only)
# REIMAGINE_API_KEY=your-reimagine-key → set in Supabase Edge Function secrets
