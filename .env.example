# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe (publishable key only — secret key stays in Supabase Edge Function secrets)
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# QA seeders (local/QA only). The seed-qa and create-test-user edge functions
# fail closed without this shared secret. Set the SAME value here and as the
# QA_SEED_SECRET Supabase Edge Function secret. Used by `npm run qa:reset`.
QA_SEED_SECRET=your-qa-seed-secret

# Server-only AI/render keys
# Do not put ANTHROPIC_API_KEY, OPENAI_API_KEY, REIMAGINE_API_KEY, or
# SUPABASE_SERVICE_ROLE_KEY in this React Native env file. Store them as
# Supabase Edge Function secrets instead.
