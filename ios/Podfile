# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'WalkerAI' do
  config = use_native_modules!

  # react-native-worklets (required by react-native-reanimated v4)
  pod 'RNWorklets', :path => '../node_modules/react-native-worklets'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Remove font files from RNVectorIcons pod to prevent duplicate bundling
    # (fonts are already added to the main target via react-native-asset)
    installer.pods_project.targets.each do |target|
      if target.name == 'RNVectorIcons'
        target.build_phases.each do |phase|
          if phase.is_a?(Xcodeproj::Project::Object::PBXResourcesBuildPhase)
            phase.files.each do |file|
              if file.file_ref && file.file_ref.path.to_s.end_with?('.ttf')
                phase.files.delete(file)
              end
            end
          end
        end
      end
    end

    # react-native-config logs the full parsed .env hash by default, which can
    # expose API keys in local/CI Xcode logs. Keep stderr visible for failures.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'react-native-config'

      target.shell_script_build_phases.each do |phase|
        next unless phase.name == '[CP-User] Config codegen'

        phase.shell_script = <<~SCRIPT
          set -e
          HOST_PATH="$SRCROOT/../.."
          "${PODS_TARGET_SRCROOT}/ios/ReactNativeConfig/BuildDotenvConfig.rb" "$HOST_PATH" "${PODS_TARGET_SRCROOT}/ios/ReactNativeConfig" >/dev/null
        SCRIPT
      end
    end

    # Fix deployment target warnings — ensure all pods meet the minimum iOS version
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 13.4
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.4'
        end
      end
    end
  end
end
