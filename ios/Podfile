# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'WalkerAI' do
  config = use_native_modules!

  # react-native-worklets (required by react-native-reanimated v4)
  pod 'RNWorklets', :path => '../node_modules/react-native-worklets'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Remove font files from RNVectorIcons pod to prevent duplicate bundling
    # (fonts are already added to the main target via react-native-asset)
    installer.pods_project.targets.each do |target|
      if target.name == 'RNVectorIcons'
        target.build_phases.each do |phase|
          if phase.is_a?(Xcodeproj::Project::Object::PBXResourcesBuildPhase)
            phase.files.each do |file|
              if file.file_ref && file.file_ref.path.to_s.end_with?('.ttf')
                phase.files.delete(file)
              end
            end
          end
        end
      end
    end

    # react-native-config logs the full parsed .env hash by default, which can
    # expose API keys in local/CI Xcode logs. Keep stderr visible for failures.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'react-native-config'

      target.shell_script_build_phases.each do |phase|
        next unless phase.name == '[CP-User] Config codegen'

        phase.shell_script = <<~SCRIPT
          set -e
          HOST_PATH="$SRCROOT/../.."
          "${PODS_TARGET_SRCROOT}/ios/ReactNativeConfig/BuildDotenvConfig.rb" "$HOST_PATH" "${PODS_TARGET_SRCROOT}/ios/ReactNativeConfig" >/dev/null
        SCRIPT
      end
    end

    # Fix deployment target warnings — ensure all pods meet the minimum iOS version
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 13.4
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.4'
        end
        if target.name == 'fmt'
          definitions = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
          definitions = [definitions] unless definitions.is_a?(Array)
          definitions << 'FMT_USE_CONSTEVAL=0' unless definitions.include?('FMT_USE_CONSTEVAL=0')
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end

    frameworks_script = File.join(
      installer.sandbox.root,
      'Target Support Files',
      'Pods-WalkerAI',
      'Pods-WalkerAI-frameworks.sh'
    )
    if File.exist?(frameworks_script)
      script = File.read(frameworks_script)
      unless script.include?('strip_code_sign_blocking_xattrs')
        helper = <<~'SH'
          strip_code_sign_blocking_xattrs() {
            local target="$1"
            if [ -e "$target" ]; then
              find "$target" -depth -print | while IFS= read -r item; do
                /usr/bin/xattr -d com.apple.FinderInfo "$item" 2>/dev/null || true
                /usr/bin/xattr -d 'com.apple.fileprovider.fpfs#P' "$item" 2>/dev/null || true
                /usr/bin/xattr -d com.apple.ResourceFork "$item" 2>/dev/null || true
                /usr/bin/xattr -d com.apple.provenance "$item" 2>/dev/null || true
              done
              /usr/bin/xattr -d com.apple.FinderInfo "$target" 2>/dev/null || true
              /usr/bin/xattr -d 'com.apple.fileprovider.fpfs#P' "$target" 2>/dev/null || true
              /usr/bin/xattr -d com.apple.ResourceFork "$target" 2>/dev/null || true
              /usr/bin/xattr -d com.apple.provenance "$target" 2>/dev/null || true
            fi
          }

        SH
        script.sub!("code_sign_if_enabled() {\n", "#{helper}code_sign_if_enabled() {\n")
        script.sub!(
          "  # Resign the code if required by the build settings to avoid unstable apps\n",
          "  strip_code_sign_blocking_xattrs \"${destination}/$(basename \"$1\")\"\n\n  # Resign the code if required by the build settings to avoid unstable apps\n"
        )
        File.write(frameworks_script, script)
      end
    end
  end
end
